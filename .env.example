# "sandbox" for testing, "live" (or "production") for real payments
PAYPAL_ENV=sandbox
# From developer.paypal.com > Apps & Credentials (Sandbox and Live keys are different!)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-client-id
PAYPAL_CLIENT_SECRET=your-secret

# MySQL (hPanel > Databases > MySQL Databases). Stores payments, settings, logo and admin login.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# First login only (min. 10 characters). After you change the username/password
# in Admin > Settings, these are ignored and can be deleted.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-something-long

# Optional: long random string for signing login sessions
SESSION_SECRET=

# Site name, logo, colors, currency and all texts are edited in Admin > Settings.
