# "sandbox" for testing, "live" (or "production") for real payments
PAYPAL_ENV=sandbox
# From developer.paypal.com > Apps & Credentials (Sandbox and Live keys are different!)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-client-id
PAYPAL_CLIENT_SECRET=your-secret

CURRENCY=ILS
# Pre-filled amount (customer can change it), and allowed range
DEFAULT_AMOUNT=50
MIN_AMOUNT=5
MAX_AMOUNT=5000
BUSINESS_NAME=Your Business Name

# Admin login at /admin/login. Password must be at least 12 characters.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-something-long
# Optional: long random string used to sign login sessions
SESSION_SECRET=

# MySQL (hPanel > Databases > MySQL Databases). Required in production,
# otherwise payments are saved to a local file that is wiped on each deploy.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
