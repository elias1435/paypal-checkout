# "sandbox" for testing, "live" (or "production") for real payments
PAYPAL_ENV=sandbox
# From developer.paypal.com > Apps & Credentials
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-client-id
PAYPAL_CLIENT_SECRET=your-secret

CURRENCY=ILS
# Used when the link has no ?amount=
DEFAULT_AMOUNT=32.40
MIN_AMOUNT=1
MAX_AMOUNT=10000
BUSINESS_NAME=My Business

# Admin login for /admin (use a long random password)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-something-long
